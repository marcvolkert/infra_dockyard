# Custom Postgres image with PostgREST-ready init scripts baked in.
# Build: podman build -t localhost/postgrest-db:16 -f postgres/Containerfile postgres
#   or:  docker build -t localhost/postgrest-db:16 -f postgres/Containerfile postgres
ARG POSTGRES_BASE_TAG=16
FROM postgres:${POSTGRES_BASE_TAG}

ARG IMAGE_VERSION=dev
ARG VCS_REF=unknown
ARG SOURCE_URL=unknown
LABEL org.opencontainers.image.title="postgrest-db" \
    org.opencontainers.image.description="PostgreSQL image with PostgREST-ready init/auth/JWT bootstrap" \
    org.opencontainers.image.version="${IMAGE_VERSION}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.source="${SOURCE_URL}" \
    org.opencontainers.image.licenses="PostgreSQL" \
    org.opencontainers.image.base.name="postgres:${POSTGRES_BASE_TAG}"

ARG POSTGRESQL_PLPYTHON3_16_VERSION=16.*

ENV POSTGRES_USER=postgres \
    POSTGRES_DB=postgres \
    PGDATA=/var/lib/postgresql/data/pgdata

# Dependencies:
# - postgresql-plpython3-16: plpython3u runtime for JWT signing/rotation
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    postgresql-plpython3-16=${POSTGRESQL_PLPYTHON3_16_VERSION} \
 && rm -rf /var/lib/apt/lists/*

COPY initdb/ /docker-entrypoint-initdb.d/

# Ensure the shell script is executable inside the image regardless
# of the host filesystem's mode bits (matters on Windows / some CI).
RUN chmod 0755 /docker-entrypoint-initdb.d/*.sh

EXPOSE 5432
